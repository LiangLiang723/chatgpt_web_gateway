{
  "name": "chatgpt-web-gateway",
  "version": "0.0.1",
  "private": true,
  "description": "OpenAI-compatible gateway backed by ChatGPT Web through Playwright Chromium.",
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.21.0",
  "scripts": {
    "dev": "tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "docker:build": "docker build --platform linux/amd64 --tag chatgpt-web-gateway:phase1 .",
    "docker:smoke": "node scripts/docker-smoke.mjs",
    "inspect:chatgpt": "xvfb-run -a tsx scripts/inspect-chatgpt.ts",
    "test:e2e:chatgpt": "xvfb-run -a tsx scripts/test-chatgpt-e2e.ts",
    "test:e2e:chatgpt:phase4": "xvfb-run -a tsx scripts/test-chatgpt-phase4-e2e.ts",
    "test:e2e:chatgpt:phase5": "xvfb-run -a tsx scripts/test-chatgpt-phase5-e2e.ts",
    "check:docs": "node scripts/check-docs.mjs",
    "check:project-memory": "node scripts/check-project-memory.mjs",
    "check:architecture": "node scripts/check-architecture.mjs",
    "check:version": "node scripts/check-version.mjs",
    "verify:repo": "node scripts/check-project-memory.mjs && node scripts/check-docs.mjs && node scripts/check-architecture.mjs && node scripts/check-version.mjs",
    "verify": "corepack pnpm format:check && corepack pnpm lint && corepack pnpm typecheck && corepack pnpm test && corepack pnpm build && corepack pnpm verify:repo"
  },
  "dependencies": {
    "@fastify/multipart": "10.1.0",
    "@fastify/type-provider-typebox": "6.1.0",
    "ajv": "8.20.0",
    "fastify": "5.11.3",
    "playwright": "1.62.1",
    "typebox": "1.3.13"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.8.1",
    "eslint-config-prettier": "10.1.8",
    "globals": "17.11.0",
    "prettier": "3.9.6",
    "tsx": "4.23.12",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.10"
  },
  "license": "MIT"
}
