# Gateway
HOST=0.0.0.0
PORT=3000
GATEWAY_BIND=0.0.0.0
GATEWAY_API_KEY=change-me
# Optional externally reachable base used for generated-image URLs, e.g. https://gateway.example/base
PUBLIC_BASE_URL=

# Runtime data
DATA_DIR=/data
DATA_PATH=./data
PUID=1000
PGID=1000

# Browser / maintenance mode
UI_MODE=headless
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
NOVNC_PASSWORD=change-me-in-maintenance-mode
MAINTENANCE_URL=https://chatgpt.com/
MAX_ACTIVE_PAGES=4
# Optional proxy used by both normal and maintenance Chromium.
CHATGPT_PROXY_SERVER=
PAGE_IDLE_TIMEOUT_MINUTES=30
STREAM_POLL_INTERVAL_MS=200

# Upload safety ceiling. ChatGPT Web may enforce a lower limit.
MAX_UPLOAD_SIZE_MB=100

# Real ChatGPT E2E tests are opt-in and require an isolated profile.
E2E_CHATGPT=0
CHATGPT_PROFILE_DIR=
CHATGPT_DIAGNOSTICS_DIR=
