# Gateway
HOST=0.0.0.0
PORT=3000
GATEWAY_BIND=0.0.0.0
GATEWAY_API_KEY=change-me
# Optional externally reachable base used for generated-image URLs, e.g. https://gateway.example/base
PUBLIC_BASE_URL=

# Runtime data
DATA_DIR=/data
DATA_PATH=./data
PUID=1000
PGID=1000

# Browser / maintenance mode
UI_MODE=headless
NOVNC_BIND=127.0.0.1
NOVNC_PORT=6080
NOVNC_PASSWORD=change-me-in-maintenance-mode
MAINTENANCE_URL=https://chatgpt.com/
MAX_ACTIVE_PAGES=4
# Optional proxy used by both normal and maintenance Chromium.
# When the proxy runs on the Docker host, use the container-safe host alias, for example:
# CHATGPT_PROXY_SERVER=http://host.docker.internal:7890
CHATGPT_PROXY_SERVER=
# Optional generic proxy variables for container tooling. Use host.docker.internal for a host proxy,
# never 127.0.0.1 (which points back to the Gateway container itself).
# HTTP_PROXY=http://host.docker.internal:7890
# HTTPS_PROXY=http://host.docker.internal:7890
# ALL_PROXY=http://host.docker.internal:7890
HTTP_PROXY=
HTTPS_PROXY=
ALL_PROXY=
NO_PROXY=
PAGE_IDLE_TIMEOUT_MINUTES=30
# Compatibility hints exposed by GET /v1/models; not official ChatGPT Web token-limit guarantees.
MODEL_CONTEXT_WINDOW=128000
MODEL_MAX_INPUT_TOKENS=128000
MODEL_MAX_OUTPUT_TOKENS=32768
STREAM_POLL_INTERVAL_MS=200

# Upload safety ceiling. ChatGPT Web may enforce a lower limit.
MAX_UPLOAD_SIZE_MB=100

# Real ChatGPT E2E tests are opt-in and require an isolated profile.
E2E_CHATGPT=0
CHATGPT_PROFILE_DIR=
CHATGPT_DIAGNOSTICS_DIR=
